# Copy this file to .env.local and fill in the values.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Twelve Data (https://twelvedata.com -> Dashboard -> API Key) ---
# Optional. Leave unset to run on Yahoo alone, which is how production runs today.
# Server-only. Never prefix with NEXT_PUBLIC_ or it leaks to the browser.
TWELVE_DATA_API_KEY=your-twelve-data-api-key
# Keep this at 8 for the Basic plan. Raise it only after upgrading the account.
TWELVE_DATA_CREDITS_PER_MINUTE=8

# Base URL used in email confirmation redirects (local dev default below).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (required for cron jobs: limit-order fills, snapshots, alerts)
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
